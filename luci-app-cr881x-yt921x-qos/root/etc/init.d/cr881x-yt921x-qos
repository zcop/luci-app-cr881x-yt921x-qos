#!/bin/sh /etc/rc.common

START=95

SERVICE_NAME="cr881x-yt921x-qos"
HELPER="/usr/sbin/cr881x-yt921x-qos"

start() {
	[ -x "$HELPER" ] || return 0
	local output
	if ! output="$("$HELPER" apply 2>&1)"; then
		logger -t "$SERVICE_NAME" "$output"
		printf '%s\n' "$output" >&2
		return 1
	fi
}

reload() {
	start
}
