#!/bin/sh

set -eu

PORT_MAX=3
DEFAULT_BURST_BYTES=65536
DEFAULT_RATE_KBPS=100000
DEFAULT_SOFT_IFACE="br-guest"
DEFAULT_SOFT_ENABLED=0
DEFAULT_SOFT_RATE_KBPS=50000
DEFAULT_SOFT_BURST_BYTES=65536
DEFAULT_PORT_MCAST_FLOOD=1
DEFAULT_PORT_BCAST_FLOOD=1

RATE_KBPS_MIN=1
RATE_KBPS_MAX=2500000

RATE_SCALE_NUM=1535
RATE_SCALE_DEN=1000
RATE_OFFSET=130
EIR_MIN_SAFE=300
EIR_MAX=262143

# Empirical shaping calibration model (CR881x current path)
# Below 120 mbit setpoint:
#   measured_mbit ~= 0.145 * set_mbit + 0.55
# Above 120 mbit:
#   measured_mbit ~= 17.75 (plateau)
CAL_SET_MBIT_LIN_MAX=120
CAL_LIN_A_NUM=145
CAL_LIN_A_DEN=1000
CAL_LIN_B_X1000=550
CAL_MEAS_MBIT_SAT_X1000=17750

EBS_UNIT=64
EBS_MAX=16383
BURST_BYTES_MIN=64
BURST_BYTES_MAX=$((EBS_MAX * EBS_UNIT))

CFG_PKG="cr881x_yt921x_qos"
CFG_FILE="/etc/config/${CFG_PKG}"

require_uinteger() {
	local name="$1"
	local value="$2"

	case "$value" in
	''|*[!0-9]*)
		echo "error: invalid $name '$value'" >&2
		return 1
		;;
	esac

	return 0
}

is_enabled_flag() {
	case "$1" in
	0|1) return 0 ;;
	esac

	return 1
}

require_uinteger_range() {
	local name="$1"
	local value="$2"
	local min="$3"
	local max="$4"
	local max_digits="${#max}"

	require_uinteger "$name" "$value" || return 1
	if [ "${#value}" -gt "$max_digits" ]; then
		echo "error: $name too large '$value'" >&2
		return 1
	fi
	if [ "$value" -lt "$min" ] || [ "$value" -gt "$max" ]; then
		echo "error: $name out of range (${min}..${max}): $value" >&2
		return 1
	fi

	return 0
}

require_iface_name() {
	local ifname="$1"

	case "$ifname" in
	''|*[!A-Za-z0-9_.:-]*)
		echo "error: invalid ifname '$ifname'" >&2
		return 1
		;;
	esac

	return 0
}

require_port() {
	local port="$1"

	require_uinteger port "$port" || return 1
	if [ "$port" -gt "$PORT_MAX" ]; then
		echo "error: port out of range (0..$PORT_MAX): $port" >&2
		return 1
	fi

	return 0
}

iface_exists() {
	ip link show dev "$1" >/dev/null 2>&1
}

port_iface() {
	case "$1" in
	0) echo "lan1" ;;
	1) echo "lan2" ;;
	2) echo "lan3" ;;
	3) echo "wan" ;;
	*)
		echo "error: unsupported port '$1'" >&2
		return 1
		;;
	esac
}

ensure_tools() {
	command -v tc >/dev/null 2>&1 || {
		echo "error: tc command is missing (install ip-full)" >&2
		return 1
	}
	command -v bridge >/dev/null 2>&1 || {
		echo "error: bridge command is missing (install ip-full)" >&2
		return 1
	}
	command -v uci >/dev/null 2>&1 || {
		echo "error: uci command is missing" >&2
		return 1
	}
}

ensure_config() {
	[ -f "$CFG_FILE" ] || return 0
}

ensure_port_section() {
	local port="$1"
	local sec="port${port}"

	if ! uci -q get "${CFG_PKG}.${sec}" >/dev/null 2>&1; then
		uci -q set "${CFG_PKG}.${sec}=port"
		uci -q set "${CFG_PKG}.${sec}.port=${port}"
		uci -q set "${CFG_PKG}.${sec}.enabled=0"
		uci -q set "${CFG_PKG}.${sec}.rate_kbps=${DEFAULT_RATE_KBPS}"
		uci -q set "${CFG_PKG}.${sec}.burst_bytes=${DEFAULT_BURST_BYTES}"
	fi

	uci -q get "${CFG_PKG}.${sec}.mcast_flood" >/dev/null 2>&1 || \
		uci -q set "${CFG_PKG}.${sec}.mcast_flood=${DEFAULT_PORT_MCAST_FLOOD}"
	uci -q get "${CFG_PKG}.${sec}.bcast_flood" >/dev/null 2>&1 || \
		uci -q set "${CFG_PKG}.${sec}.bcast_flood=${DEFAULT_PORT_BCAST_FLOOD}"
}

cfg_get_port_enabled() {
	local port="$1"
	uci -q get "${CFG_PKG}.port${port}.enabled" || echo "0"
}

cfg_get_port_rate() {
	local port="$1"
	uci -q get "${CFG_PKG}.port${port}.rate_kbps" || echo "$DEFAULT_RATE_KBPS"
}

cfg_get_port_burst() {
	local port="$1"
	uci -q get "${CFG_PKG}.port${port}.burst_bytes" || echo "$DEFAULT_BURST_BYTES"
}

cfg_get_port_mcast_flood() {
	local port="$1"
	uci -q get "${CFG_PKG}.port${port}.mcast_flood" || echo "$DEFAULT_PORT_MCAST_FLOOD"
}

cfg_get_port_bcast_flood() {
	local port="$1"
	uci -q get "${CFG_PKG}.port${port}.bcast_flood" || echo "$DEFAULT_PORT_BCAST_FLOOD"
}

cfg_set_port() {
	local port="$1"
	local enabled="$2"
	local rate_kbps="$3"
	local burst_bytes="$4"

	ensure_port_section "$port"
	uci -q set "${CFG_PKG}.port${port}.enabled=${enabled}"
	uci -q set "${CFG_PKG}.port${port}.rate_kbps=${rate_kbps}"
	uci -q set "${CFG_PKG}.port${port}.burst_bytes=${burst_bytes}"
	uci -q commit "$CFG_PKG"
}

cfg_set_port_flood() {
	local port="$1"
	local mcast_flood="$2"
	local bcast_flood="$3"

	ensure_port_section "$port"
	uci -q set "${CFG_PKG}.port${port}.mcast_flood=${mcast_flood}"
	uci -q set "${CFG_PKG}.port${port}.bcast_flood=${bcast_flood}"
	uci -q commit "$CFG_PKG"
}

cfg_get_global_enabled() {
	uci -q get "${CFG_PKG}.globals.enabled" || echo "1"
}

cfg_set_global_enabled() {
	local enabled="$1"

	uci -q set "${CFG_PKG}.globals=globals"
	uci -q set "${CFG_PKG}.globals.enabled=${enabled}"
	uci -q commit "$CFG_PKG"
}

ensure_soft_section() {
	if ! uci -q get "${CFG_PKG}.soft" >/dev/null 2>&1; then
		uci -q set "${CFG_PKG}.soft=soft"
		uci -q set "${CFG_PKG}.soft.ifname=${DEFAULT_SOFT_IFACE}"
		uci -q set "${CFG_PKG}.soft.enabled=${DEFAULT_SOFT_ENABLED}"
		uci -q set "${CFG_PKG}.soft.rate_kbps=${DEFAULT_SOFT_RATE_KBPS}"
		uci -q set "${CFG_PKG}.soft.burst_bytes=${DEFAULT_SOFT_BURST_BYTES}"
	fi
}

cfg_get_soft_ifname() {
	uci -q get "${CFG_PKG}.soft.ifname" || echo "${DEFAULT_SOFT_IFACE}"
}

cfg_get_soft_enabled() {
	uci -q get "${CFG_PKG}.soft.enabled" || echo "${DEFAULT_SOFT_ENABLED}"
}

cfg_get_soft_rate() {
	uci -q get "${CFG_PKG}.soft.rate_kbps" || echo "${DEFAULT_SOFT_RATE_KBPS}"
}

cfg_get_soft_burst() {
	uci -q get "${CFG_PKG}.soft.burst_bytes" || echo "${DEFAULT_SOFT_BURST_BYTES}"
}

cfg_set_soft() {
	local ifname="$1"
	local enabled="$2"
	local rate_kbps="$3"
	local burst_bytes="$4"

	ensure_soft_section
	uci -q set "${CFG_PKG}.soft.ifname=${ifname}"
	uci -q set "${CFG_PKG}.soft.enabled=${enabled}"
	uci -q set "${CFG_PKG}.soft.rate_kbps=${rate_kbps}"
	uci -q set "${CFG_PKG}.soft.burst_bytes=${burst_bytes}"
	uci -q commit "$CFG_PKG"
}

validate_rate_kbps() {
	require_uinteger_range rate_kbps "$1" "$RATE_KBPS_MIN" "$RATE_KBPS_MAX"
}

validate_burst_bytes() {
	require_uinteger_range burst_bytes "$1" "$BURST_BYTES_MIN" "$BURST_BYTES_MAX"
}

rate_kbps_to_eir() {
	local rate_kbps="$1"
	local eir

	require_uinteger rate_kbps "$rate_kbps" || return 1
	if [ "$rate_kbps" -eq 0 ]; then
		echo "error: rate_kbps must be > 0" >&2
		return 1
	fi

	eir=$(( (rate_kbps * RATE_SCALE_NUM + (RATE_SCALE_DEN / 2)) / RATE_SCALE_DEN + RATE_OFFSET ))
	if [ "$eir" -lt "$EIR_MIN_SAFE" ]; then
		eir="$EIR_MIN_SAFE"
	fi
	if [ "$eir" -gt "$EIR_MAX" ]; then
		eir="$EIR_MAX"
	fi

	echo "$eir"
}

burst_bytes_to_ebs() {
	local burst_bytes="$1"
	local ebs

	require_uinteger burst_bytes "$burst_bytes" || return 1
	if [ "$burst_bytes" -eq 0 ]; then
		echo "error: burst_bytes must be > 0" >&2
		return 1
	fi

	ebs=$(( (burst_bytes + EBS_UNIT - 1) / EBS_UNIT ))
	if [ "$ebs" -gt "$EBS_MAX" ]; then
		ebs="$EBS_MAX"
	fi

	echo "$ebs"
}

estimate_measured_kbps_from_set_kbps() {
	local set_kbps="$1"
	local set_mbit
	local measured_x1000

	require_uinteger set_kbps "$set_kbps" || return 1
	set_mbit=$(( set_kbps / 1000 ))
	if [ "$set_mbit" -ge "$CAL_SET_MBIT_LIN_MAX" ]; then
		measured_x1000="$CAL_MEAS_MBIT_SAT_X1000"
	else
		measured_x1000=$(( (CAL_LIN_A_NUM * set_kbps + (CAL_LIN_A_DEN / 2)) / CAL_LIN_A_DEN + CAL_LIN_B_X1000 ))
	fi
	echo "$measured_x1000"
}

estimate_measured_rate() {
	local set_kbps="$1"
	local measured_x1000
	local measured_mbit_int
	local measured_mbit_frac

	validate_rate_kbps "$set_kbps" || return 1
	measured_x1000="$(estimate_measured_kbps_from_set_kbps "$set_kbps")"
	measured_mbit_int=$(( measured_x1000 / 1000 ))
	measured_mbit_frac=$(( measured_x1000 % 1000 ))

	printf "set_kbps=%s estimated_measured_kbps=%s estimated_measured_mbit=%d.%03d\n" \
		"$set_kbps" "$measured_x1000" "$measured_mbit_int" "$measured_mbit_frac"
}

suggest_set_rate() {
	local target_mbit="$1"
	local target_x1000
	local set_kbps
	local measured_x1000
	local measured_mbit_int
	local measured_mbit_frac

	require_uinteger_range target_mbit "$target_mbit" 1 10000 || return 1
	target_x1000=$(( target_mbit * 1000 ))

	if [ "$target_x1000" -ge "$CAL_MEAS_MBIT_SAT_X1000" ]; then
		set_kbps=$(( CAL_SET_MBIT_LIN_MAX * 1000 ))
	else
		if [ "$target_x1000" -le "$CAL_LIN_B_X1000" ]; then
			set_kbps="$RATE_KBPS_MIN"
		else
			set_kbps=$(( ((target_x1000 - CAL_LIN_B_X1000) * CAL_LIN_A_DEN + (CAL_LIN_A_NUM / 2)) / CAL_LIN_A_NUM ))
			if [ "$set_kbps" -lt "$RATE_KBPS_MIN" ]; then
				set_kbps="$RATE_KBPS_MIN"
			fi
		fi
	fi

	if [ "$set_kbps" -gt "$RATE_KBPS_MAX" ]; then
		set_kbps="$RATE_KBPS_MAX"
	fi

	measured_x1000="$(estimate_measured_kbps_from_set_kbps "$set_kbps")"
	measured_mbit_int=$(( measured_x1000 / 1000 ))
	measured_mbit_frac=$(( measured_x1000 % 1000 ))

	printf "target_mbit=%s recommended_set_kbps=%s estimated_measured_kbps=%s estimated_measured_mbit=%d.%03d\n" \
		"$target_mbit" "$set_kbps" "$measured_x1000" "$measured_mbit_int" "$measured_mbit_frac"
}

apply_port_runtime() {
	local port="$1"
	local enabled="$2"
	local rate_kbps="$3"
	local burst_bytes="$4"
	local iface

	iface="$(port_iface "$port")"

	if [ "$enabled" -eq 1 ]; then
		tc qdisc replace dev "$iface" root tbf \
			rate "${rate_kbps}kbit" \
			burst "${burst_bytes}" \
			latency 100ms >/dev/null
	else
		tc qdisc del dev "$iface" root >/dev/null 2>&1 || true
	fi
}

bridge_flag_state() {
	local iface="$1"
	local flag="$2"
	local out

	out="$(bridge -d link show dev "$iface" 2>/dev/null | tr '\n' ' ' || true)"
	out=" ${out} "
	case "$out" in
	*" ${flag} off "*) echo 0 ;;
	*" ${flag} on "*) echo 1 ;;
	*) echo -1 ;;
	esac
}

apply_port_flood_runtime() {
	local port="$1"
	local mcast_flood="$2"
	local bcast_flood="$3"
	local iface
	local mcast_word
	local bcast_word

	iface="$(port_iface "$port")"
	if [ "$mcast_flood" -eq 1 ]; then
		mcast_word="on"
	else
		mcast_word="off"
	fi
	if [ "$bcast_flood" -eq 1 ]; then
		bcast_word="on"
	else
		bcast_word="off"
	fi

	bridge link set dev "$iface" mcast_flood "$mcast_word" bcast_flood "$bcast_word" >/dev/null 2>&1
}

apply_soft_runtime() {
	local ifname="$1"
	local enabled="$2"
	local rate_kbps="$3"
	local burst_bytes="$4"

	if [ "$enabled" -eq 1 ]; then
		if ! iface_exists "$ifname"; then
			echo "error: interface '$ifname' not found" >&2
			return 1
		fi

		tc qdisc replace dev "$ifname" root tbf \
			rate "${rate_kbps}kbit" \
			burst "${burst_bytes}" \
			latency 100ms >/dev/null
	else
		tc qdisc del dev "$ifname" root >/dev/null 2>&1 || true
	fi
}

show_status_port() {
	local port="$1"
	local enabled
	local rate_kbps
	local burst_bytes
	local eir
	local ebs
	local cfg_mcast_flood
	local cfg_bcast_flood
	local mcast_flood
	local bcast_flood
	local iface

	require_port "$port" || return 1
	enabled="$(cfg_get_port_enabled "$port")"
	rate_kbps="$(cfg_get_port_rate "$port")"
	burst_bytes="$(cfg_get_port_burst "$port")"
	cfg_mcast_flood="$(cfg_get_port_mcast_flood "$port")"
	cfg_bcast_flood="$(cfg_get_port_bcast_flood "$port")"

	if ! require_uinteger enabled "$enabled"; then
		enabled=0
	fi
	if ! validate_rate_kbps "$rate_kbps"; then
		rate_kbps="$DEFAULT_RATE_KBPS"
	fi
	if ! validate_burst_bytes "$burst_bytes"; then
		burst_bytes="$DEFAULT_BURST_BYTES"
	fi
	if ! is_enabled_flag "$cfg_mcast_flood"; then
		cfg_mcast_flood="$DEFAULT_PORT_MCAST_FLOOD"
	fi
	if ! is_enabled_flag "$cfg_bcast_flood"; then
		cfg_bcast_flood="$DEFAULT_PORT_BCAST_FLOOD"
	fi

	iface="$(port_iface "$port")"
	mcast_flood="$(bridge_flag_state "$iface" mcast_flood)"
	bcast_flood="$(bridge_flag_state "$iface" bcast_flood)"
	if [ "$mcast_flood" -lt 0 ]; then
		mcast_flood="$cfg_mcast_flood"
	fi
	if [ "$bcast_flood" -lt 0 ]; then
		bcast_flood="$cfg_bcast_flood"
	fi

	if [ "$enabled" -eq 1 ]; then
		eir="$(rate_kbps_to_eir "$rate_kbps" 2>/dev/null || echo 0)"
		ebs="$(burst_bytes_to_ebs "$burst_bytes" 2>/dev/null || echo 0)"
	else
		eir=0
		ebs=0
		rate_kbps=0
		burst_bytes=0
	fi

	echo "tbf p${port}: en=${enabled} dual_rate=0 meter=0 eir=${eir} ebs=${ebs} rate_kbps=${rate_kbps} burst_bytes=${burst_bytes} mcast_flood=${mcast_flood} bcast_flood=${bcast_flood}"
}

show_status_soft() {
	local ifname
	local enabled
	local rate_kbps
	local burst_bytes

	ifname="$(cfg_get_soft_ifname)"
	enabled="$(cfg_get_soft_enabled)"
	rate_kbps="$(cfg_get_soft_rate)"
	burst_bytes="$(cfg_get_soft_burst)"

	if ! require_iface_name "$ifname"; then
		ifname="$DEFAULT_SOFT_IFACE"
	fi
	if ! is_enabled_flag "$enabled"; then
		enabled="$DEFAULT_SOFT_ENABLED"
	fi
	if ! validate_rate_kbps "$rate_kbps"; then
		rate_kbps="$DEFAULT_SOFT_RATE_KBPS"
	fi
	if ! validate_burst_bytes "$burst_bytes"; then
		burst_bytes="$DEFAULT_SOFT_BURST_BYTES"
	fi
	if [ "$enabled" -eq 0 ]; then
		rate_kbps=0
		burst_bytes=0
	fi

	echo "soft if=${ifname} en=${enabled} rate_kbps=${rate_kbps} burst_bytes=${burst_bytes}"
}

show_status() {
	local port
	local global_enabled

	ensure_tools || return 1
	ensure_config
	global_enabled="$(cfg_get_global_enabled)"
	if ! is_enabled_flag "$global_enabled"; then
		global_enabled=1
	fi
	echo "global enabled=${global_enabled}"
	for port in 0 1 2 3; do
		show_status_port "$port"
	done
	show_status_soft
}

set_global() {
	local enabled="$1"

	ensure_tools || return 1
	ensure_config

	if ! is_enabled_flag "$enabled"; then
		echo "error: enabled must be 0 or 1" >&2
		return 1
	fi

	cfg_set_global_enabled "$enabled"
	apply_saved
	echo "global enabled=${enabled}"
}

set_port() {
	local port="$1"
	local rate_kbps="$2"
	local burst_bytes="${3:-$DEFAULT_BURST_BYTES}"

	ensure_tools || return 1
	ensure_config
	require_port "$port" || return 1
	validate_rate_kbps "$rate_kbps" || return 1
	validate_burst_bytes "$burst_bytes" || return 1

	apply_port_runtime "$port" 1 "$rate_kbps" "$burst_bytes"
	cfg_set_port "$port" 1 "$rate_kbps" "$burst_bytes"
	show_status_port "$port"
}

disable_port() {
	local port="$1"
	local rate_kbps
	local burst_bytes

	ensure_tools || return 1
	ensure_config
	require_port "$port" || return 1

	rate_kbps="$(cfg_get_port_rate "$port")"
	burst_bytes="$(cfg_get_port_burst "$port")"
	if ! validate_rate_kbps "$rate_kbps"; then
		rate_kbps="$DEFAULT_RATE_KBPS"
	fi
	if ! validate_burst_bytes "$burst_bytes"; then
		burst_bytes="$DEFAULT_BURST_BYTES"
	fi

	apply_port_runtime "$port" 0 0 0
	cfg_set_port "$port" 0 "$rate_kbps" "$burst_bytes"
	show_status_port "$port"
}

set_port_flood() {
	local port="$1"
	local mcast_flood="$2"
	local bcast_flood="$3"

	ensure_tools || return 1
	ensure_config
	require_port "$port" || return 1
	if ! is_enabled_flag "$mcast_flood"; then
		echo "error: mcast_flood must be 0 or 1" >&2
		return 1
	fi
	if ! is_enabled_flag "$bcast_flood"; then
		echo "error: bcast_flood must be 0 or 1" >&2
		return 1
	fi

	cfg_set_port_flood "$port" "$mcast_flood" "$bcast_flood"
	apply_port_flood_runtime "$port" "$mcast_flood" "$bcast_flood"
	show_status_port "$port"
}

set_soft() {
	local ifname="$1"
	local enabled="$2"
	local rate_kbps="$3"
	local burst_bytes="${4:-$DEFAULT_SOFT_BURST_BYTES}"

	ensure_tools || return 1
	ensure_config
	require_iface_name "$ifname" || return 1
	if ! is_enabled_flag "$enabled"; then
		echo "error: enabled must be 0 or 1" >&2
		return 1
	fi
	validate_rate_kbps "$rate_kbps" || return 1
	validate_burst_bytes "$burst_bytes" || return 1

	if [ "$enabled" -eq 1 ] && ! iface_exists "$ifname"; then
		echo "error: interface '$ifname' not found" >&2
		return 1
	fi

	apply_soft_runtime "$ifname" "$enabled" "$rate_kbps" "$burst_bytes"
	cfg_set_soft "$ifname" "$enabled" "$rate_kbps" "$burst_bytes"
	show_status_soft
}

apply_saved() {
	local port
	local global_enabled
	local enabled
	local rate_kbps
	local burst_bytes
	local mcast_flood
	local bcast_flood

	ensure_tools || return 1
	ensure_config

	global_enabled="$(cfg_get_global_enabled)"
	if ! is_enabled_flag "$global_enabled"; then
		global_enabled=1
	fi

	for port in 0 1 2 3; do
		ensure_port_section "$port"
		enabled="$(cfg_get_port_enabled "$port")"
		rate_kbps="$(cfg_get_port_rate "$port")"
		burst_bytes="$(cfg_get_port_burst "$port")"
		mcast_flood="$(cfg_get_port_mcast_flood "$port")"
		bcast_flood="$(cfg_get_port_bcast_flood "$port")"

		if ! is_enabled_flag "$enabled"; then
			enabled=0
		fi
		if ! validate_rate_kbps "$rate_kbps"; then
			rate_kbps="$DEFAULT_RATE_KBPS"
		fi
		if ! validate_burst_bytes "$burst_bytes"; then
			burst_bytes="$DEFAULT_BURST_BYTES"
		fi
		if ! is_enabled_flag "$mcast_flood"; then
			mcast_flood="$DEFAULT_PORT_MCAST_FLOOD"
		fi
		if ! is_enabled_flag "$bcast_flood"; then
			bcast_flood="$DEFAULT_PORT_BCAST_FLOOD"
		fi

		apply_port_flood_runtime "$port" "$mcast_flood" "$bcast_flood" || true

		if [ "$global_enabled" -eq 1 ] && [ "$enabled" -eq 1 ]; then
			apply_port_runtime "$port" 1 "$rate_kbps" "$burst_bytes" || true
		else
			apply_port_runtime "$port" 0 0 0 || true
		fi
	done

	local soft_ifname
	local soft_enabled
	local soft_rate_kbps
	local soft_burst_bytes

	soft_ifname="$(cfg_get_soft_ifname)"
	soft_enabled="$(cfg_get_soft_enabled)"
	soft_rate_kbps="$(cfg_get_soft_rate)"
	soft_burst_bytes="$(cfg_get_soft_burst)"

	if ! require_iface_name "$soft_ifname"; then
		soft_ifname="$DEFAULT_SOFT_IFACE"
	fi
	if ! is_enabled_flag "$soft_enabled"; then
		soft_enabled="$DEFAULT_SOFT_ENABLED"
	fi
	if ! validate_rate_kbps "$soft_rate_kbps"; then
		soft_rate_kbps="$DEFAULT_SOFT_RATE_KBPS"
	fi
	if ! validate_burst_bytes "$soft_burst_bytes"; then
		soft_burst_bytes="$DEFAULT_SOFT_BURST_BYTES"
	fi

	if [ "$global_enabled" -eq 1 ] && [ "$soft_enabled" -eq 1 ]; then
		apply_soft_runtime "$soft_ifname" 1 "$soft_rate_kbps" "$soft_burst_bytes" || true
	else
		apply_soft_runtime "$soft_ifname" 0 0 0 || true
	fi
}

get_flood_filter() {
	echo "error: flood filter control is unavailable in release backend" >&2
	return 1
}

set_flood_filter() {
	echo "error: flood filter control is unavailable in release backend" >&2
	return 1
}

usage() {
	cat <<'EOF'
Usage: cr881x-yt921x-qos <command>

Commands:
  status                         Dump QoS status for all ports
  status-port <port>             Dump QoS status for one port
  estimate-rate <set_kbps>       Estimate real throughput from configured setpoint
  suggest-rate <target_mbit>     Recommend set_kbps for desired real Mbps
  set-port <port> <kbps> [burst] Set persistent per-port TBF
  disable-port <port>            Disable persistent per-port TBF
  set-port-flood <port> <mcast 0|1> <bcast 0|1>
                                Set persistent per-port flood flags
  set-global <0|1>               Set persistent global QoS master state
  set-soft <if> <0|1> <kbps> [burst]
                                Set persistent software TBF on interface
  status-soft                    Dump software TBF status
  apply                          Apply saved UCI settings to tc
  get-flood-filter               Unsupported in release backend
  set-flood-filter               Unsupported in release backend
EOF
}

cmd="${1:-status}"
case "$cmd" in
status)
	shift || true
	show_status "$@"
	;;
status-port)
	shift || true
	show_status_port "${1:-}"
	;;
estimate-rate)
	shift || true
	estimate_measured_rate "${1:-}"
	;;
suggest-rate)
	shift || true
	suggest_set_rate "${1:-}"
	;;
set-port)
	shift || true
	set_port "${1:-}" "${2:-}" "${3:-$DEFAULT_BURST_BYTES}"
	;;
disable-port)
	shift || true
	disable_port "${1:-}"
	;;
set-port-flood)
	shift || true
	set_port_flood "${1:-}" "${2:-}" "${3:-}"
	;;
set-global)
	shift || true
	set_global "${1:-}"
	;;
set-soft)
	shift || true
	set_soft "${1:-}" "${2:-}" "${3:-}" "${4:-$DEFAULT_SOFT_BURST_BYTES}"
	;;
status-soft)
	shift || true
	show_status_soft "$@"
	;;
apply)
	shift || true
	apply_saved "$@"
	;;
get-flood-filter)
	shift || true
	get_flood_filter "$@"
	;;
set-flood-filter)
	shift || true
	set_flood_filter "$@"
	;;
help|-h|--help)
	usage
	;;
*)
	echo "error: unknown command '$cmd'" >&2
	usage >&2
	exit 2
	;;
esac
