#!/usr/bin/ucode

'use strict';

import { access, popen } from 'fs';

const helper = '/usr/sbin/cr881x-yt921x-qos';
const port_max = 3;
const default_burst_bytes = 65536;
const default_soft_iface = 'br-guest';
const default_soft_enabled = 0;
const default_soft_rate_kbps = 50000;
const default_soft_burst_bytes = 65536;
const default_port_mcast_flood = 1;
const default_port_bcast_flood = 1;
const rate_kbps_min = 1;
const rate_kbps_max = 2500000;
const burst_bytes_min = 64;
const burst_bytes_max = 1048512;

function shell_quote(s) {
	if (s == null || s == '')
		return "''";

	return "'" + replace(s, "'", "'\\''") + "'";
}

function run_helper(args) {
	let command = helper;
	let output = '';

	for (let i = 0; i < length(args); i++)
		command += ' ' + shell_quote(args[i]);

	command += ' 2>&1';

	const fd = popen(command, 'r');
	if (fd == null) {
		return {
			code: -1,
			output: 'failed to execute helper'
		};
	}

	for (let line = fd.read('line'); length(line); line = fd.read('line'))
		output += line;

	return {
		code: fd.close(),
		output: trim(output)
	};
}

function parse_tbf_line(line) {
	line = trim(line);
	if (!line || index(line, 'tbf p') != 0)
		return null;

	let colon = index(line, ':');
	if (colon < 0)
		return null;

	let port_str = substr(line, 5, colon - 5);
	let tail = trim(substr(line, colon + 1));

	let item = {
		port: +port_str,
		en: 0,
		dual_rate: 0,
		meter: 0,
		eir: 0,
		ebs: 0,
		rate_kbps: -1,
		burst_bytes: -1,
		mcast_flood: default_port_mcast_flood,
		bcast_flood: default_port_bcast_flood,
		raw: line
	};

	let fields = split(tail, ' ');
	for (let i = 0; i < length(fields); i++) {
		let f = fields[i];
		let eq = index(f, '=');
		if (eq <= 0)
			continue;

		let k = substr(f, 0, eq);
		let v = substr(f, eq + 1);

		if (k == 'en')
			item.en = +v;
		else if (k == 'dual_rate')
			item.dual_rate = +v;
		else if (k == 'meter')
			item.meter = +v;
		else if (k == 'eir')
			item.eir = +v;
		else if (k == 'ebs')
			item.ebs = +v;
		else if (k == 'rate_kbps')
			item.rate_kbps = +v;
		else if (k == 'burst_bytes')
			item.burst_bytes = +v;
		else if (k == 'mcast_flood')
			item.mcast_flood = int(+v) ? 1 : 0;
		else if (k == 'bcast_flood')
			item.bcast_flood = int(+v) ? 1 : 0;
	}

	if (!(item.rate_kbps >= 0))
		item.rate_kbps = (item.eir * 1000) / 1548;

	if (!(item.burst_bytes >= 0))
		item.burst_bytes = item.ebs * 64;

	return item;
}

function parse_soft_line(line) {
	line = trim(line);
	if (!line || index(line, 'soft ') != 0)
		return null;

	let tail = trim(substr(line, 5));
	let item = {
		ifname: default_soft_iface,
		en: default_soft_enabled,
		rate_kbps: 0,
		burst_bytes: 0,
		raw: line
	};

	let fields = split(tail, ' ');
	for (let i = 0; i < length(fields); i++) {
		let f = fields[i];
		let eq = index(f, '=');
		if (eq <= 0)
			continue;

		let k = substr(f, 0, eq);
		let v = substr(f, eq + 1);

		if (k == 'if')
			item.ifname = v || default_soft_iface;
		else if (k == 'en')
			item.en = int(+v);
		else if (k == 'rate_kbps')
			item.rate_kbps = int(+v);
		else if (k == 'burst_bytes')
			item.burst_bytes = int(+v);
	}

	return item;
}

function parse_status_output(output) {
	let ports = [];
	let global_enabled = 1;
	let soft = {
		ifname: default_soft_iface,
		en: default_soft_enabled,
		rate_kbps: 0,
		burst_bytes: 0
	};
	let lines = split(output, '\n');

	for (let i = 0; i < length(lines); i++) {
		let line = trim(lines[i]);
		if (index(line, 'global enabled=') == 0) {
			let val = trim(substr(line, 15));
			if (val == '0' || val == '1')
				global_enabled = int(+val);
			continue;
		}

		let p = parse_tbf_line(lines[i]);
		if (p != null) {
			ports[length(ports)] = p;
			continue;
		}

		let s = parse_soft_line(lines[i]);
		if (s != null)
			soft = s;
	}

	return {
		global_enabled,
		ports,
		soft
	};
}

function status_call() {
	if (!access(helper, 'x')) {
		return {
			ok: false,
			code: 127,
			error: `${helper} is missing`
		};
	}

	const res = run_helper([ 'status' ]);
	const parsed = parse_status_output(res.output);

	return {
		ok: (res.code == 0),
		code: res.code,
		error: (res.code == 0) ? '' : (res.output || 'status failed'),
		output: res.output,
		global_enabled: parsed.global_enabled,
		ports: parsed.ports,
		soft: parsed.soft
	};
}

function is_decimal_uint(v, max_digits) {
	v = trim(`${v ?? ''}`);
	if (!v || length(v) > max_digits)
		return false;

	for (let i = 0; i < length(v); i++) {
		const c = substr(v, i, 1);
		if (c < '0' || c > '9')
			return false;
	}

	return true;
}

function parse_uint_bounded(v, fallback, min, max, max_digits) {
	if (v == null || v == '')
		return fallback;

	if (!is_decimal_uint(v, max_digits))
		return null;

	const n = int(+v);
	if (!(n >= min && n <= max))
		return null;

	return n;
}

function parse_bool01(v, fallback) {
	if (v == null || v == '')
		return fallback;

	v = trim(`${v}`);
	if (v == '0' || v == '1')
		return int(+v);

	return null;
}

function parse_ifname(v, fallback) {
	const s = trim(`${v ?? ''}`);
	if (!s)
		return fallback;
	if (match(s, /[^A-Za-z0-9_.:-]/))
		return null;
	return s;
}

function get_info_call() {
	return {
		helper,
		backend: 'tc',
		port_max,
		features: {
			persistent: true,
			port_tbf: true,
			soft_tbf: true,
			port_flood_flags: true,
			flood_filter: false
		}
	};
}

function set_port_call(args) {
	if (!access(helper, 'x')) {
		return {
			ok: false,
			code: 127,
			error: `${helper} is missing`
		};
	}

	const port = parse_uint_bounded(args?.port, null, 0, port_max, 1);
	const enable = parse_bool01(args?.enable, 1);
	const rate_kbps = parse_uint_bounded(args?.rate_kbps, 0, rate_kbps_min, rate_kbps_max, 7);
	const burst_bytes = parse_uint_bounded(args?.burst_bytes, default_burst_bytes, burst_bytes_min, burst_bytes_max, 7);
	const mcast_flood = parse_bool01(args?.mcast_flood, default_port_mcast_flood);
	const bcast_flood = parse_bool01(args?.bcast_flood, default_port_bcast_flood);

	if (port == null || port > port_max) {
		return {
			ok: false,
			code: -22,
			error: `invalid port (0..${port_max})`
		};
	}

	if (enable == null) {
		return {
			ok: false,
			code: -22,
			error: 'enable must be 0 or 1'
		};
	}

	if (enable && rate_kbps == null) {
		return {
			ok: false,
			code: -22,
			error: `rate_kbps must be ${rate_kbps_min}..${rate_kbps_max} when enabled`
		};
	}

	if (enable && burst_bytes == null) {
		return {
			ok: false,
			code: -22,
			error: `burst_bytes must be ${burst_bytes_min}..${burst_bytes_max} when enabled`
		};
	}
	if (mcast_flood == null || bcast_flood == null) {
		return {
			ok: false,
			code: -22,
			error: 'mcast_flood and bcast_flood must be 0 or 1'
		};
	}

	const cmd = !enable ? 'disable-port' : 'set-port';
	const cmd_args = [ cmd, `${port}` ];
	if (cmd == 'set-port') {
		cmd_args[length(cmd_args)] = `${rate_kbps}`;
		cmd_args[length(cmd_args)] = `${burst_bytes}`;
	}

	const res = run_helper(cmd_args);
	let flood_res = { code: 0, output: '' };
	if (res.code == 0)
		flood_res = run_helper([ 'set-port-flood', `${port}`, `${mcast_flood}`, `${bcast_flood}` ]);

	const st = status_call();
	const op_ok = (res.code == 0 && flood_res.code == 0);
	const op_err = (res.code != 0)
		? (res.output || 'set_port failed')
		: ((flood_res.code != 0) ? (flood_res.output || 'set_port_flood failed') : '');

	return {
		ok: op_ok,
		code: op_ok ? 0 : ((res.code != 0) ? res.code : flood_res.code),
		error: op_err,
		output: trim((res.output || '') + '\n' + (flood_res.output || '')),
		status: st
	};
}

function set_global_call(args) {
	if (!access(helper, 'x')) {
		return {
			ok: false,
			code: 127,
			error: `${helper} is missing`
		};
	}

	const enable = parse_bool01(args?.enable, null);
	if (enable == null) {
		return {
			ok: false,
			code: -22,
			error: 'enable must be 0 or 1'
		};
	}

	const res = run_helper([ 'set-global', `${enable}` ]);
	const st = status_call();

	return {
		ok: (res.code == 0),
		code: res.code,
		error: (res.code == 0) ? '' : (res.output || 'set_global failed'),
		output: res.output,
		status: st
	};
}

function set_port_flood_call(args) {
	if (!access(helper, 'x')) {
		return {
			ok: false,
			code: 127,
			error: `${helper} is missing`
		};
	}

	const port = parse_uint_bounded(args?.port, null, 0, port_max, 1);
	const mcast_flood = parse_bool01(args?.mcast_flood, null);
	const bcast_flood = parse_bool01(args?.bcast_flood, null);

	if (port == null || port > port_max) {
		return {
			ok: false,
			code: -22,
			error: `invalid port (0..${port_max})`
		};
	}

	if (mcast_flood == null || bcast_flood == null) {
		return {
			ok: false,
			code: -22,
			error: 'mcast_flood and bcast_flood must be 0 or 1'
		};
	}

	const res = run_helper([ 'set-port-flood', `${port}`, `${mcast_flood}`, `${bcast_flood}` ]);
	const st = status_call();

	return {
		ok: (res.code == 0),
		code: res.code,
		error: (res.code == 0) ? '' : (res.output || 'set_port_flood failed'),
		output: res.output,
		status: st
	};
}

function set_soft_call(args) {
	if (!access(helper, 'x')) {
		return {
			ok: false,
			code: 127,
			error: `${helper} is missing`
		};
	}

	const ifname = parse_ifname(args?.ifname, default_soft_iface);
	const enable = parse_bool01(args?.enable, null);
	const rate_kbps = parse_uint_bounded(args?.rate_kbps, default_soft_rate_kbps, rate_kbps_min, rate_kbps_max, 7);
	const burst_bytes = parse_uint_bounded(args?.burst_bytes, default_soft_burst_bytes, burst_bytes_min, burst_bytes_max, 7);

	if (ifname == null) {
		return {
			ok: false,
			code: -22,
			error: 'invalid interface name'
		};
	}

	if (enable == null) {
		return {
			ok: false,
			code: -22,
			error: 'enable must be 0 or 1'
		};
	}

	if (enable && rate_kbps == null) {
		return {
			ok: false,
			code: -22,
			error: `rate_kbps must be ${rate_kbps_min}..${rate_kbps_max} when enabled`
		};
	}

	if (enable && burst_bytes == null) {
		return {
			ok: false,
			code: -22,
			error: `burst_bytes must be ${burst_bytes_min}..${burst_bytes_max} when enabled`
		};
	}

	const res = run_helper([ 'set-soft', ifname, `${enable}`, `${rate_kbps}`, `${burst_bytes}` ]);
	const st = status_call();

	return {
		ok: (res.code == 0),
		code: res.code,
		error: (res.code == 0) ? '' : (res.output || 'set_soft failed'),
		output: res.output,
		status: st
	};
}

const methods = {
	get_info: {
		call: function() {
			return get_info_call();
		}
	},

	status: {
		call: function() {
			return status_call();
		}
	},

	set_port: {
		args: {
			port: 'port',
			enable: 'enable',
			rate_kbps: 'rate_kbps',
			burst_bytes: 'burst_bytes',
			mcast_flood: 'mcast_flood',
			bcast_flood: 'bcast_flood'
		},
		call: function(req) {
			return set_port_call(req?.args || {});
		}
	},

	set_global: {
		args: {
			enable: 'enable'
		},
		call: function(req) {
			return set_global_call(req?.args || {});
		}
	},

	set_port_flood: {
		args: {
			port: 'port',
			mcast_flood: 'mcast_flood',
			bcast_flood: 'bcast_flood'
		},
		call: function(req) {
			return set_port_flood_call(req?.args || {});
		}
	},

	set_soft: {
		args: {
			ifname: 'ifname',
			enable: 'enable',
			rate_kbps: 'rate_kbps',
			burst_bytes: 'burst_bytes'
		},
		call: function(req) {
			return set_soft_call(req?.args || {});
		}
	}
};

return { 'luci.cr881x_yt921x_qos': methods };
